{
  "expo": {
    "name": "SafeNest",
    "slug": "mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app-safenest-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/logo-app-safenest-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo-app-safenest-icon.png"
      },
      "package": "com.anonymous.mobile"
    },
    "web": {
      "favicon": "./assets/logo-app-safenest-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08757224-bca5-4b0e-9bec-c4777c5a0971"
      }
    }
  }
}
